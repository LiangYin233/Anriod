{
  "name": "@anriod/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --minify --sourcemap --target=bun src/index.ts --outfile anriod",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=1",
    "test:watch": "bun test --parallel=1 --watch"
  },
  "dependencies": {
    "@anriod/shared": "file:../shared",
    "hono": "^4.3.0",
    "drizzle-orm": "^0.30.0",
    "croner": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
