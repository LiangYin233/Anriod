{
  "name": "@anriod/backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --compile --minify --sourcemap --target=bun --define process.env.NODE_ENV='\"production\"' src/index.ts --outfile anriod",
    "typecheck": "tsc --noEmit",
    "test": "bun test --parallel=1",
    "test:watch": "bun test --parallel=1 --watch",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@anriod/shared": "file:../shared",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.5.0",
    "typescript-eslint": "^8.61.1"
  }
}
