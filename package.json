{
  "name": "anriod",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter @anriod/backend dev",
    "dev:frontend": "bun --filter @anriod/frontend dev",
    "build:backend": "bun --filter @anriod/backend build",
    "build:frontend": "bun --filter @anriod/frontend build",
    "typecheck": "npm --workspace @anriod/backend run typecheck && npm --workspace @anriod/frontend run typecheck",
    "lint": "bun run --filter '*' lint",
    "check": "bun lint && bun typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
