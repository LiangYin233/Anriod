# Dependencies
node_modules/

# Package manager noise
# Bun is the primary package manager; npm lockfiles are unintended noise.
package-lock.json

# Build output
dist/
packages/backend/anriod
packages/backend/anriod.exe
packages/frontend/dist/

# Runtime data (contains secrets and user data)
packages/backend/config.yaml
packages/backend/data/
*.db
*.db-journal

# Tauri / Rust build output
packages/frontend/src-tauri/target/
packages/frontend/src-tauri/gen/schemas/

# Tauri generated mobile project
# Keep packages/frontend/src-tauri/gen/android/ tracked so others can build without re-init.
# Its nested .gitignore files exclude local Gradle/Tauri build output.

# Generated optional store/mobile icon sets
packages/frontend/src-tauri/icons/ios/
packages/frontend/src-tauri/icons/Square*Logo.png
packages/frontend/src-tauri/icons/StoreLogo.png

# Android signing material (sensitive)
*.jks
*.keystore
*.p12
*.pfx
key.properties
keystore.properties

# Android build artifacts
*.apk
*.aab
*.ap_
*.idsig

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / agent-local state
.vscode/
.reasonix/
.claude/
.codegraph/
AGENTS.md
.trae/

# OS
.DS_Store
Thumbs.db

# Temp / local scripts
scripts/
